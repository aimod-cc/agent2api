{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent2API",
  "version": "2.7.5",
  "identifier": "com.workbuddy.local-proxy",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "aimod-cc",
    "copyright": "Copyright (c) 2026 aimod-cc",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese"
        ]
      }
    },
    "shortDescription": "Agent2API · 多提供商本地网关",
    "longDescription": "把多家 AI 客户端登录态（WorkBuddy、小浣熊等）包装成本地 OpenAI 兼容接口，并集中管理多账号、出网代理与内容脱敏。网关已整体由 Rust 实现并运行在应用进程内，不再随包分发任何外部运行时，安装体积小、启动即用。"
  }
}
