{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBuddy 本地代理",
  "version": "1.0.1",
  "identifier": "com.workbuddy.local-proxy",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/server.cjs": "resources/server.cjs",
      "resources/node.exe": "resources/node.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese"]
      }
    },
    "shortDescription": "WorkBuddy 本地代理 · 会话与多账号管理",
    "longDescription": "把 WorkBuddy 登录态包装成本地 OpenAI 兼容接口，并集中管理多账号、出网代理与内容脱敏。安装后开箱即用，无需单独安装 Node。"
  }
}
