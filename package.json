{
  "name": "agent2api",
  "version": "2.9.0",
  "description": "Agent2API - 多提供商本地网关：把 WorkBuddy / 小浣熊 / CatPaw / AutoClaw 等客户端登录态包装成 OpenAI 兼容接口，附带账号管理、出站指纹脱敏与请求报表",
  "type": "module",
  "private": true,
  "scripts": {
    "build:icon": "node build/make-icon.mjs",
    "test": "node --test desktop-tauri/ui/*.test.mjs",
    "server:test": "bash scripts/rust-check.sh test --manifest-path desktop-tauri/src-tauri/server/Cargo.toml",
    "server:build": "bash scripts/rust-check.sh build --manifest-path desktop-tauri/src-tauri/server/Cargo.toml",
    "tauri:install": "npm --prefix desktop-tauri install",
    "tauri:dev": "npm --prefix desktop-tauri run dev",
    "tauri:build": "npm --prefix desktop-tauri run build"
  },
  "keywords": [
    "agent2api",
    "workbuddy",
    "raccoon",
    "catpaw",
    "autoclaw",
    "codebuddy",
    "tencent",
    "api",
    "proxy",
    "openai",
    "sse",
    "llm"
  ],
  "author": "aimod-cc",
  "repository": {
    "type": "git",
    "url": "https://github.com/aimod-cc/agent2api.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=18.17.0"
  }
}
